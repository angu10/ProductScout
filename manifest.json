{
  "manifest_version": 3,
  "name": "Agent-Powered PromptBridge",
  "version": "1.0.0",
  "description": "AI-powered e-commerce product analysis using Chrome Built-in AI APIs",
  "permissions": [
    "tabs",
    "activeTab", 
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.ebay.com/*",
    "https://www.walmart.com/*",
    "https://www.target.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
            "https://www.amazon.com/*",
            "https://www.ebay.com/*",
            "https://www.walmart.com/*",
            "https://www.target.com/*"
      ],
      "js": [
        "utils/helpers.js",
        "agents/detector.js",
        "agents/extractor.js",
        "ai/prompt-processor.js",
        "ai/agent-orchestrator.js",
        "ui/widget.js",
        "content.js"
      ],
      "css": [
        "ui/styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptBridge"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/widget.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "trial_tokens": [
    "ArbO+WySLMK3SgCASOUJLck9WOao/i2qVsmKQhzzZGSbNfBVaak0UPpmMrnKX36nntcUZisNealTomuMZE+j8QkAAAB7eyJvcmlnaW4iOiJjaHJvbWUtZXh0ZW5zaW9uOi8vZ2tmZGpqcGpoY3BkYmxrYm1pbmRqcGZjaWhrcGNsbmgiLCJmZWF0dXJlIjoiQUlQcm9tcHRBUElNdWx0aW1vZGFsSW5wdXQiLCJleHBpcnkiOjE3NzQzMTA0MDB9"
    
  ]
}